#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800	// 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 200   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>


&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
    trigger-period-ms = <8>;          // 8
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&caps_word {
  continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <10>;
    };

    behaviors {
      n9grave: nine_grave {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp N9>, <&kp GRAVE>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      n0tilde: zero_tilde {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp N0>, <&kp TILDE>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      commasemi: comma_semi {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp COMMA>, <&kp SEMI>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      dotcolon: dot_colon {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp DOT>, <&kp COLON>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      bslhnosft: backslash_no_shift {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp BSLH>, <&kp BSLH>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      lbktnosft: leftbracket_no_shift {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LBKT>, <&kp LBKT>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      rbktnosft: rightbracket_no_shift {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp RBKT>, <&kp RBKT>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
      dotnosft: dot_no_shift {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp DOT>, <&kp DOT>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
      };
    };

    combos {
      compatible = "zmk,combos";
      combo_caps_lock {
        timeout-ms = <50>;
        bindings = <&caps_word>;
        key-positions = <26 38>;
      };
    };

    conditional-layers {
      compatible = "zmk,conditional-layers";
      layer5 {
        if-layers = <2 3>;
        then-layer = <4>;
      };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3     &kp N4     &kp N5    &kp UP       &kp N6  &kp N7    &kp N8      &n9grave   &n0tilde  &kp PSCRN
&kp EQUAL  &kp Q     &kp W     &kp F      &kp P      &kp B     &kp DOWN     &kp J   &kp L     &kp U       &kp Y      &kp SQT   &kp MINUS
&kp LSHFT  &kp A     &kp R     &kp S      &kp T      &kp G     &kp LEFT     &kp M   &kp N     &kp E       &kp I      &kp O     &kp RSHFT
&kp TAB    &kp Z     &kp X     &kp C      &kp D      &kp V     &kp RIGHT    &kp K   &kp H     &commasemi  &dotcolon  &kp FSLH  &kp RET
&none      &kp LALT  &kp LGUI  &kp LCTRL  &kp SPACE  &mo 2     &none        &mo 3   &kp BSPC  &kp RCTRL   &kp RGUI   &kp RALT
            >;
            sensor-bindings = <&scroll_encoder>;
            display-name = "Colemak";
        };

        layer1 {
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3     &kp N4     &kp N5   &kp UP       &kp N6  &kp N7    &kp N8     &kp N9    &kp N0    &kp EQUAL
&kp GRAVE  &kp Q     &kp W     &kp E      &kp R      &kp T    &kp DOWN     &kp Y   &kp U     &kp I      &kp O     &kp P     &kp MINUS
&kp LSHFT  &kp A     &kp S     &kp D      &kp F      &kp G    &kp LEFT     &kp H   &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp TAB    &kp Z     &kp X     &kp C      &kp V      &kp B    &kp RIGHT    &kp N   &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RET
&none      &kp LALT  &kp LGUI  &kp LCTRL  &kp SPACE  &mo 2    &none        &mo 3   &kp BSPC  &kp LBKT   &kp RBKT  &kp BSLH
            >;
            sensor-bindings = <&scroll_encoder>;
            display-name = "Gaming";
        };

        layer2 {
            bindings = <
&kp F1  &kp F2        &kp F3    &kp F4    &kp F5     &kp F6        &mmv MOVE_UP       &kp F7   &kp F8  &kp F9    &kp F10   &kp F11     &kp F12
&trans  &kp C_MUTE    &kp HOME  &none     &kp PG_UP  &kp C_PP      &mmv MOVE_DOWN     &none    &kp N7  &kp N8    &n9grave  &kp PIPE    &trans
&trans  &kp C_VOL_UP  &mkp MB2  &mkp MB3  &mkp MB1   &kp C_NEXT    &mmv MOVE_LEFT     &kp DEL  &kp N4  &kp N5    &kp N6    &bslhnosft  &trans
&trans  &kp C_VOL_DN  &kp END   &none     &kp PG_DN  &kp C_PREV    &mmv MOVE_RIGHT    &kp INS  &kp N1  &kp N2    &kp N3    &dotnosft   &trans
&trans  &trans        &trans    &trans    &trans     &trans        &none              &trans   &trans  &n0tilde  &n0tilde  &n0tilde
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "Numpad";
        };

        layer3 {
            bindings = <
&kp F1  &kp F2  &kp F3    &kp F4      &kp F5    &kp F6     &mmv MOVE_UP       &kp F7      &kp F8     &kp F9    &kp F10    &kp F11       &kp F12
&trans  &none   &none     &none       &none     &none      &mmv MOVE_DOWN     &kp C_PP    &kp PG_UP  &kp UP    &kp HOME   &kp C_MUTE    &trans
&trans  &kp LT  &kp LBRC  &lbktnosft  &kp LPAR  &kp DEL    &mmv MOVE_LEFT     &kp C_NEXT  &kp LEFT   &kp DOWN  &kp RIGHT  &kp C_VOL_UP  &trans
&trans  &kp GT  &kp RBRC  &rbktnosft  &kp RPAR  &kp INS    &mmv MOVE_RIGHT    &kp C_PREV  &kp PG_DN  &none     &kp END    &kp C_VOL_DN  &trans
&trans  &trans  &trans    &trans      &trans    &trans     &none              &trans      &trans     &trans    &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "Symbol";
        };

        layer4 {
            bindings = <
&rgb_ug RGB_ON   &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &rgb_ug RGB_SPI    &none    &none  &none  &none  &none  &none  &none
&rgb_ug RGB_OFF  &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_EFR  &rgb_ug RGB_SPD    &none    &none  &none  &none  &none  &none  &none
&none            &to 0            &to 1            &none            &none            &none              &none    &none  &none  &none  &none  &none  &none
&none            &none            &none            &none            &none            &none              &none    &none  &none  &none  &none  &none  &none
&none            &none            &none            &none            &none            &none              &none    &none  &none  &none  &none  &none 
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "Settings";
        };
    };
};



